# Copy to .env and edit as needed.
GPU_LIST_PRIMARY="0,1"
# Optional override. Leave empty to use system default.
# CUDA_VISIBLE_DEVICES="0,1"
PYTHON_BIN="python"
USE_LOCAL_CUDNN_OVERRIDE="auto"   # auto|force|off
INSTALL_MISSING_DEPS="false"      # true|false
VIT_ENABLE="true"                 # true|false
RERUN_FAILED_ONLY="false"         # true|false
LOG_TIMESTAMP="true"              # true|false
DRY_RUN="false"                   # true|false
CONTINUE_ON_ERROR="true"          # true|false (used by run_all_blocked.sh)
